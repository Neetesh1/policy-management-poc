# ── Application ────────────────────────────────────────────────────────────────
PORT=3000

# ── Host port mappings for Docker Compose ──────────────────────────────────────
# Controls which ports are exposed on the host machine.
# Local dev defaults (no entry needed — docker-compose.yml uses these as fallback):
#   APP_HOST_PORT=4211
#   ONLYOFFICE_HOST_PORT=3005
# Uncomment and set for your server:
# APP_HOST_PORT=3000
# ONLYOFFICE_HOST_PORT=8080

# Public URL that browsers use to reach this app
# Local dev:  http://localhost:4211
# Server:     http://<server-ip>:<APP_HOST_PORT>
APP_URL=http://localhost:4211

# Internal URL that ONLYOFFICE Document Server uses to fetch files & send callbacks.
# When running with Docker Compose, use the service name: http://app:3000
# For local dev (no Docker), keep it the same as APP_URL
ONLYOFFICE_APP_URL=http://app:3000

# URL that the browser uses to load the ONLYOFFICE editor API script
# Local dev:  http://localhost:3005
# Server:     http://<server-ip>:<ONLYOFFICE_HOST_PORT>
ONLYOFFICE_SERVER_URL=http://localhost:3005

# ── Security ────────────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a strong random secret before any shared/production use.
# Must match the JWT_SECRET set in the ONLYOFFICE Document Server environment.
JWT_SECRET=poc-secret-change-in-production

# ── Storage (optional overrides) ───────────────────────────────────────────────
# Absolute path to the data directory (DB + document versions).
# Defaults to <project_root>/data
# DATA_PATH=/absolute/path/to/data

# ── White-label branding (optional) ────────────────────────────────────────────
# https://api.onlyoffice.com/docs/docs-api/usage-api/config/editor/customization/customization-white-label/
# These fields require the extended white-label license add-on for ONLYOFFICE Docs
# Developer — on a trial/Community-tier server they are silently ignored.
# WHITE_LABEL_LOADER_NAME=Loading policy document…
# WHITE_LABEL_LOADER_LOGO_URL=https://example.com/loader-logo.png
# WHITE_LABEL_SHOW_ABOUT=false

